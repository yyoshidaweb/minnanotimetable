<% if @performances.present? %>
  <%# タイムテーブル表示画面のメインコンテナ（画面全体の高さに設定する） %>
  <div class="h-full flex flex-col overflow-hidden pb-[calc(5.25rem+env(safe-area-inset-bottom))]">
    <%# スクロールコンテナ（ヘッダーと日付選択タブの高さ分下げた位置に配置する。min-h-0で内側だけスクロール） %>
    <div class="flex-1 min-h-0 pt-24 overflow-auto overscroll-none relative">
      <%# 横幅確保 %>
      <div class="min-w-max">
        <%# ヘッダー行（入場規制バッジは該当ステージ列のみステージ名下に固定） %>
        <div class="flex sticky top-0 z-110 bg-white">
          <%# 左上空白 %>
          <div class="sticky left-0 w-5 bg-white z-100"></div>
          <%# ステージヘッダー（バッジも含めて詳細モーダルへ） %>
          <% @stages.each do |stage| %>
            <%= link_to event_stage_path(@event.event_key, stage),
                data: { turbo_frame: "modal" },
                class: "stage-header-col flex-1 flex flex-col w-0 min-w-16 overflow-hidden z-95 border-b" do %>
              <span class="flex justify-center items-center min-h-8 max-h-12 text-xs font-bold text-center p-px">
                <span class="line-clamp-3 wrap-break-word w-full"><%= stage.stage_name_tag.name %></span>
              </span>
              <% if stage.admission_restricted? %>
                <%= render "stages/admission_restricted_badge" %>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <%# ボディ %>
        <div class="flex relative">
          <%# 時刻列（sticky left） %>
          <div class="w-5 sticky left-0 z-150 bg-white">
            <% time_slots_for_timetable(@performances).each do |hour| %>
              <p class="h-24 text-xs text-center pt-1 tabular-nums -translate-y-2.75">
                <%= hour %>
              </p>
            <% end %>
          </div>
          <%# ステージを展開 %>
          <% @stages.each do |stage| %>
            <div class="timetable-body-col flex-1 w-0 min-w-16 relative"
                style="height: <%= timetable_height_rem(@performances) %>rem;">
              <%# 各ステージの出演情報を検索 %>
              <% if @performances_by_stage[stage.id].present? %>
                <% @performances_by_stage[stage.id].each do |performance| %>
                  <%# 出演情報カード %>
                  <%= link_to event_performer_path(@event.event_key, performance.performer),
                      id: "my_timetable_performance_#{performance.id}",
                      data: { turbo_frame: "modal" },
                      class: "absolute left-px right-px bg-white rounded shadow-xs p-px text-xs",
                      style: "
                        top: #{performance_top_rem(performance)}rem;
                        height: #{performance_height_rem(performance)}rem;" do %>
                    <% if performance.show_start_time? %>
                      <div class="text-[10px] leading-none text-gray-500">
                        <%= formatted_time(performance.start_time) %>
                      </div>
                    <% end %>
                    <% duration = performance.duration %>
                    <% line_clamp = line_clamp_class_by_duration(duration) %>
                    <% font_size = font_size_class_by_duration(duration) %>
                    <% translate_y = translate_y_by_duration(duration) %>
                    <%# 出演者名 %>
                    <p class="font-semibold leading-none wrap-break-word
                              <%= font_size %> <%= line_clamp %> <%= translate_y %>">
                      <%= render "performances/favorite_marker", performance: performance %>
                    </p>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <%# ===== お気に入り出演情報が0件の場合 ===== %>
  <div class="h-full p-12 flex flex-col items-center justify-center pb-[calc(5.25rem+env(safe-area-inset-bottom))]">
    <% if my_timetable_owner? %>
      <p class="text-gray-800 mb-4">出演情報をお気に入り登録すると、<br>
        ここにマイタイムテーブルが表示されます！</p>
    <% else %>
      <p class="text-gray-800 mb-8">まだ、マイタイムテーブルが作られていません。</p>
    <% end %>
  </div>
<% end %>
