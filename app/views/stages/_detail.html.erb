<%# 編集ボタン（作成者本人のみ表示） %>
<% if user_signed_in? && current_user == @event.user %>
  <% edit_link_options = local_assigns[:in_modal] ? { data: { action: "click->modal#navigate" } } : {} %>
  <%= link_to edit_event_stage_path(@event.event_key, @stage),
              **edit_link_options,
              class: "absolute #{local_assigns[:in_modal] ? 'top-10 right-4' : 'top-4 right-0'} text-xs text-gray-800" do %>
    <span class="material-symbols-outlined">edit</span>
  <% end %>
<% end %>
<%# ステージ名 %>
<h1 class="text-xl font-bold text-gray-900 mb-2">
  <%= @stage.stage_name_tag.name %>
</h1>
<% if @stage.admission_restricted? %>
  <p class="mb-4">
    <%= render "stages/admission_restricted_badge" %>
  </p>
<% end %>
<%# 説明 %>
<% if @stage.description.present? %>
  <div class="mb-6">
    <%= auto_link_text(@stage.description) %>
  </div>
<% end %>
<%# 住所 %>
<% if @stage.address.present? %>
  <div class="mb-6">
    <h2 class="text-md font-bold text-gray-900 mb-2">住所</h2>
    <p class="text-gray-800 whitespace-pre-line"><%= @stage.address %></p>
  </div>
<% end %>
<% if local_assigns[:in_modal] && user_signed_in? && current_user == @event.user %>
  <div class="mt-4 flex justify-end">
    <%= link_to event_stage_path(@event.event_key, @stage),
                data: { turbo_frame: "_top" },
                class: "text-sm font-semibold text-blue-600 hover:underline" do %>
      詳細→
    <% end %>
  </div>
<% end %>
