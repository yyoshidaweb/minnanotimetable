<%# ステージ名直下の入場規制行（stickyにせず縦スクロールに追従しない） %>
<div class="flex stage-admission-status-row">
  <div class="sticky left-0 w-5 bg-white z-100"></div>
  <% stages.each do |stage| %>
    <div class="stage-admission-status-col flex-1 flex justify-center items-center min-h-[1em] w-0 min-w-16 overflow-hidden border-b text-center px-px">
      <% if stage.admission_restricted? %>
        <span class="w-full m-px rounded bg-yellow-400 text-white text-xs leading-tight font-bold px-0.5 py-px text-left wrap-break-word shadow">
          入場規制中
        </span>
      <% end %>
    </div>
  <% end %>
</div>
