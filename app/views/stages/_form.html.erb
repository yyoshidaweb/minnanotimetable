<% editing = local_assigns.fetch(:editing, false) %>
<% form_wrapper_class = modal_edit_context? ? "p-6 pt-10" : "max-w-md mx-auto p-6 bg-white shadow-md rounded-lg" %>
<div class="<%= form_wrapper_class %>"
            data-controller="tag-suggestion"
            data-tag-suggestion-url-value="<%= search_stage_name_tags_path %>">
  <% form_data = modal_edit_context? ? { turbo_frame: "_top" } : { turbo: turbo_frame_request? } %>
  <%# 送信時の Turbo 有無で通常のフォームとモーダルを分岐する %>
  <%= form_with model: stage,
                data: form_data,
                url: editing ? event_stage_path(@event.event_key, stage) : event_stages_path(@event.event_key),
                method: editing ? :patch : :post,
                class: "space-y-6" do |f| %>
    <%# エラーメッセージ %>
    <%= render "devise/shared/error_messages", resource: stage %>
    <% if modal_edit_context? %>
      <%= hidden_field_tag :from_modal, "1" %>
    <% end %>
    <%# ─ ステージ名（タグ入力＋候補表示） ─ %>
    <div>
      <%= f.label :stage_name_tag, "ステージ名", class: "block text-sm font-semibold text-gray-800 mb-1" %>
      <%# fields_for を使って nested attributes の形で name を送る (stage[stage_name_tag_attributes][name]) %>
      <%= f.fields_for :stage_name_tag do |ff| %>
        <%= ff.text_field :name,
                  value: stage.stage_name_tag&.name,
                  class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-800 
                          focus:outline-none focus:ring-1 focus:ring-gray-800 focus:border-gray-800",
                  data: {
                    tag_suggestion_target: "input",
                    action: "input->tag-suggestion#search"
                  } %>
        <%# タグ候補（ポップアップ表示領域） %>
        <div class="relative" data-tag-suggestion-target="results"></div>
      <% end %>
    </div>
    <%# 説明欄 %>
    <div>
      <%= f.label :description, "説明", class: "block text-sm font-semibold text-gray-800 mb-1" %>
      <%= f.text_area :description,
                class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-800
                        focus:outline-none focus:ring-1 focus:ring-gray-800 focus:border-gray-800 min-h-32 resize-y overflow-y-auto"%>
    </div>
    <%# 住所 %>
    <div>
      <%= f.label :address, "住所", class: "block text-sm font-semibold text-gray-800 mb-1" %>
      <%= f.text_field :address,
                class: "w-full border border-gray-300 rounded-md px-3 py-2 text-gray-800 focus:outline-none focus:ring-1 focus:ring-gray-800 focus:border-gray-800" %>
    </div>
    <%# 入場規制 %>
    <div>
      <label class="inline-flex items-center gap-2 cursor-pointer">
        <%= f.check_box :admission_restricted,
                  class: "rounded border-gray-300 text-gray-800 focus:ring-gray-800" %>
        <span class="text-sm font-semibold text-gray-800">入場規制中</span>
      </label>
      <p class="mt-1 text-xs text-gray-500">オンにするとタイムテーブルのステージ名下にバッジを表示します。</p>
    </div>
    <%# 送信ボタン %>
    <div>
      <%= f.submit editing ? "更新" : "作成",
                class: "w-full py-2 rounded-md bg-gray-800 text-white hover:bg-gray-900 transition cursor-pointer" %>
    </div>
  <% end %>
  <% if editing %>
    <% if modal_edit_context? %>
      <div class="mt-4 flex justify-end">
        <%= link_to "キャンセル",
                    event_stage_path(@event.event_key, stage),
                    data: { action: "click->modal#navigate" },
                    class: "text-sm text-gray-600 hover:underline" %>
      </div>
    <% end %>
    <%= button_to "削除",
                event_stage_path(@event.event_key, stage),
                method: :delete,
                params: modal_edit_context? ? { from_modal: "1" } : {},
                data: {
                  turbo_confirm: "⚠️ 削除しますか？ 一度削除すると元に戻せません",
                  turbo_frame: modal_edit_context? ? "_top" : nil
                }.compact,
                class: "flex justify-center w-full mt-24 py-2 rounded-md bg-gray-800 text-red-500 hover:bg-red-700 hover:text-red-200 transition cursor-pointer" %>
  <% end %>
</div>
