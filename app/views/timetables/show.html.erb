<%# 検索結果などに表示されるタイトルと説明 %>
<% content_for :title, "#{@event.display_name} タイムテーブル | みんなのタイムテーブル" %>
<% content_for :description, "#{@event.display_name}のタイムテーブル。#{@event.description if @event.description.present?}" %>
<% if timetable_event_owner? %>
  <% content_for :head do %>
    <%= timetable_bottom_spacer_root_style_tag %>
  <% end %>
<% end %>
<%# 日付選択タブ（イベントヘッダーの高さ分下げて配置する） %>
<% if @days.any?%>
  <nav class="flex h-8 fixed top-16 z-160 w-full justify-around overflow-x-auto bg-white border-t border-gray-200">
    <% @days.each do |day| %>
      <%# 日付を MM/DD 形式でラベルに整形 %>
      <% label = day.date.strftime("%-m/%-d") %>
      <%# 現在選択中の日付かどうか判定 %>
      <% selected = (day.date == @selected_date) %>
      <%# 日付タブリンク。選択中の場合は下線を表示し、横幅は均等に伸ばす %>
      <%= link_to url_for(d: day.date),
            class: "flex-1 px-2 py-2 text-xs text-gray-800 font-bold border-b-4 #{selected ? 'border-gray-800' : 'border-transparent'} hover:border-gray-300 transition-colors duration-150 text-center whitespace-nowrap" do %>
        <%= label %>
      <% end %>
    <% end %>
  </nav>
<% end %>
<% if @performances.present? %>
  <%# タイムテーブル表示画面のメインコンテナ（画面全体の高さに設定する） %>
  <div class="h-full flex flex-col overflow-hidden pb-[calc(5.25rem+env(safe-area-inset-bottom))]">
    <%# スクロールコンテナ（ヘッダーと日付選択タブの高さ分下げた位置に配置する。min-h-0で内側だけスクロール） %>
    <div class="flex-1 min-h-0 pt-24 overflow-auto overscroll-none relative">
      <%# 横幅確保 %>
      <div class="min-w-max">
        <%# ヘッダー行（入場規制バッジは該当ステージ列のみステージ名下に固定） %>
        <div class="flex sticky top-0 z-110 bg-white">
          <%# 左上空白 %>
          <div class="sticky left-0 w-5 bg-white z-100"></div>
          <%# ステージヘッダー（バッジも含めて詳細モーダルへ） %>
          <% @stages.each do |stage| %>
            <%= link_to event_stage_path(@event.event_key, stage),
                data: { turbo_frame: "modal" },
                class: "stage-header-col flex-1 flex flex-col w-0 min-w-16 overflow-hidden z-95 border-b" do %>
              <span class="flex justify-center items-center min-h-8 max-h-12 text-xs font-bold text-center p-px">
                <span class="line-clamp-3 wrap-break-word w-full"><%= stage.stage_name_tag.name %></span>
              </span>
              <% if stage.admission_restricted? %>
                <%= render "stages/admission_restricted_badge", variant: :timetable %>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <%# ボディ %>
        <div class="flex relative">
          <%# 時刻列（sticky left） %>
          <div class="w-5 sticky left-0 z-150 bg-white">
            <% time_slots_for_timetable(@performances).each do |hour| %>
              <p class="h-24 text-xs text-center pt-1 tabular-nums -translate-y-2.75">
                <%= hour %>
              </p>
            <% end %>
            <% if timetable_event_owner? %>
              <%# タイムテーブル領域下の余白分の時刻（末尾の次の正時のみ） %>
              <p class="h-[var(--timetable-bottom-spacer)] text-xs text-center pt-1 tabular-nums -translate-y-2.75">
                <%= timetable_bottom_spacer_hour(@performances) %>
              </p>
            <% end %>
          </div>
          <%# ステージを展開（オーナーのみ下余白を含める） %>
          <% @stages.each do |stage| %>
            <div class="timetable-body-col flex-1 w-0 min-w-16 relative"
                style="<%= timetable_body_col_height_style(@performances) %>">
              <%# 各ステージの出演情報を検索 %>
              <% if @performances_by_stage[stage.id].present? %>
                <% @performances_by_stage[stage.id].each do |performance| %>
                  <%# 出演情報カード %>
                  <%= link_to event_performer_path(@event.event_key, performance.performer),
                      data: { turbo_frame: "modal" },
                      class: "absolute left-px right-px bg-white rounded shadow-xs p-px text-xs",
                      style: "
                        top: #{performance_top_rem(performance)}rem;
                        height: #{performance_height_rem(performance)}rem;" do %>
                    <% if performance.show_start_time? %>
                      <div class="text-[10px] leading-none text-gray-500">
                        <%= formatted_time(performance.start_time) %>
                      </div>
                    <% end %>
                    <% duration = performance.duration %>
                    <% line_clamp = line_clamp_class_by_duration(duration) %>
                    <% font_size = font_size_class_by_duration(duration) %>
                    <% translate_y = translate_y_by_duration(duration) %>
                    <%# 出演者名 %>
                    <p class="font-semibold leading-none wrap-break-word
                              <%= font_size %> <%= line_clamp %> <%= translate_y %>">
                      <%= render "performances/favorite_marker", performance: performance %>
                    </p>
                  <% end %>
                <% end %>
              <% end %>
              <% if timetable_event_owner? %>
                <%# 下余白の先頭1時間より下の区切り線を隠す %>
                <div class="timetable-bottom-spacer-cover" aria-hidden="true"></div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      <%# 下部タブメニュー %>
      <%= render "layouts/bottom_tab" %>
    </div>
  </div>
  <% if timetable_event_owner? %>
    <%= render "timetables/bottom_actions" %>
  <% end %>
<% else %>
  <%# ===== 情報が揃った出演情報が0件の場合 ===== %>
  <div class="h-full p-12 flex flex-col items-center justify-center pb-[calc(5.25rem+env(safe-area-inset-bottom))]">
    <% if user_signed_in? && current_user == @event.user %>
      <div class="max-w-md flex flex-col justify-center items-center">
        <p class="text-gray-500 mb-4">タイムテーブルを完成させましょう！</p>
        <%= link_to new_event_timetable_path(@event.event_key),
                      class: "w-full relative flex items-center justify-center p-3 bg-gray-800 text-white rounded-full shadow hover:bg-gray-900" do %>
          <span class="material-symbols-outlined">wand_stars</span>
          <small class="text-sm">画像から作成する</small>
        <% end %>
        <small class="mt-1 text-center text-xs text-gray-500 whitespace-normal md:whitespace-nowrap">
          AIが画像を解析してタイムテーブルを作成します。
        </small>
        <p class="text-gray-500 my-4">または</p>
        <%= link_to new_event_performance_path(@event.event_key),
                      class: "w-full relative flex items-center justify-center p-3 bg-gray-800 text-white rounded-full shadow hover:bg-gray-900" do %>
          <span class="material-symbols-outlined">calendar_add_on</span>
          <small class="text-sm">出演情報を追加</small>
        <% end %>
      <% else %>
        <p class="text-gray-500 mb-8">まだ、出演情報がありません</p>
      <% end %>
    </div>
  </div>
  <%# 下部タブメニュー %>
  <%= render "layouts/bottom_tab" %>
<% end %>