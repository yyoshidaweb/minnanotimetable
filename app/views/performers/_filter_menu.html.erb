<%# 所有者向け：出演者絞り込みのオーバーフローメニュー %>
<div class="relative" data-controller="overflow-menu">
  <button type="button"
          data-overflow-menu-target="button"
          data-action="click->overflow-menu#toggle"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-label="絞り込み"
          class="inline-flex items-center justify-center p-1.5 rounded-full text-gray-800
                 cursor-pointer hover:bg-gray-100
                 <%= "bg-gray-100" if unset_items_filter? %>">
    <span class="material-symbols-outlined<%= " material-symbols-filled" if unset_items_filter? %>"
          style="font-size: 1.5rem;">filter_alt</span>
  </button>
  <div data-overflow-menu-target="menu"
       role="menu"
       hidden
       class="absolute right-0 z-20 mt-1 min-w-44 rounded-md border border-gray-200 bg-white py-1 shadow-lg">
    <%= link_to "未設定項目あり",
                event_performers_path(@event.event_key, filter: "unset"),
                role: "menuitem",
                class: "block px-4 py-2 text-sm text-gray-800 hover:bg-gray-50
                        #{'bg-gray-50 font-semibold' if unset_items_filter?}" %>
    <% if unset_items_filter? %>
      <%= link_to "すべて表示",
                  event_performers_path(@event.event_key),
                  role: "menuitem",
                  class: "block px-4 py-2 text-sm text-gray-800 hover:bg-gray-50" %>
    <% end %>
  </div>
</div>
